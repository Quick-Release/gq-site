# Local DDEV database. These values are intentionally local-only.
DB_NAME='db'
DB_USER='db'
DB_PASSWORD='db'
DB_HOST='db'
DB_PREFIX='wp_'

# Bedrock / WordPress URLs
WP_ENV='development'
WP_ENVIRONMENT_TYPE='local'
WP_HOME='https://{{project}}-admin.ddev.site'
WP_SITEURL="${WP_HOME}/wp"

# The storefront's dev server (vp dev); WordPress permalinks point here.
GETQUICK_FRONTEND_URL='http://localhost:3000'

# Media: local uploads stay on disk (never set R2 credentials locally, they
# would write to the live bucket). Once gq.ops.json has media.domain,
# `pnpm cms:dev` adds S3_UPLOADS_BUCKET_URL so synced media missing locally is
# served from the bucket.
DISABLE_WP_CRON='false'

# Local-only salts. Replace every value before using this file for production.
AUTH_KEY='{{project}}-local-auth-key'
SECURE_AUTH_KEY='{{project}}-local-secure-auth-key'
LOGGED_IN_KEY='{{project}}-local-logged-in-key'
NONCE_KEY='{{project}}-local-nonce-key'
AUTH_SALT='{{project}}-local-auth-salt'
SECURE_AUTH_SALT='{{project}}-local-secure-auth-salt'
LOGGED_IN_SALT='{{project}}-local-logged-in-salt'
NONCE_SALT='{{project}}-local-nonce-salt'
