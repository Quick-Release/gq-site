# Ploi database credentials
DB_NAME='{{project}}'
DB_USER='{{project}}'
DB_PASSWORD='replace-with-a-strong-password'
DB_HOST='127.0.0.1'
DB_PREFIX='wp_'

# Bedrock / WordPress URLs
WP_ENV='production'
WP_ENVIRONMENT_TYPE='production'
WP_HOME='https://{{domains.admin}}'
WP_SITEURL="${WP_HOME}/wp"

# Keep GraphQL diagnostics off in production.
GRAPHQL_DEBUG='false'
# Comma-separated exact frontend origins.
GRAPHQL_CORS_ORIGINS='https://{{domains.frontend}}'
# The headless frontend; WordPress permalinks point here.
GETQUICK_FRONTEND_URL='https://{{domains.frontend}}'
# The key publication events to the Frontend are signed with: the Site's
# PUBLICATION_EVENT_SECRET from Sigillo staging, set by `pnpm ploi:events`.
PUBLICATION_EVENT_SECRET=''

# Media uploads on R2 (S3 Uploads). Empty values keep uploads on the server.
S3_UPLOADS_BUCKET=''
S3_UPLOADS_KEY=''
S3_UPLOADS_SECRET=''
S3_UPLOADS_ENDPOINT=''
S3_UPLOADS_BUCKET_URL=''

# GQ Design imports and updates Google font families with the fleet's Google
# Fonts Developer API key, from Sigillo GETQUICK Registry prod, set by
# `pnpm ploi:fonts`. Empty turns font import and update off.
GETQUICK_GOOGLE_FONTS_API_KEY=''

# Visits never start WP-Cron: the server's cron runs WordPress's due events
# every minute (`wp cron event run --due-now`, added by `pnpm ploi:provision`).
DISABLE_WP_CRON='true'

# Generate unique values for every key before deploying:
#   openssl rand -base64 48
AUTH_KEY='replace-me'
SECURE_AUTH_KEY='replace-me'
LOGGED_IN_KEY='replace-me'
NONCE_KEY='replace-me'
AUTH_SALT='replace-me'
SECURE_AUTH_SALT='replace-me'
LOGGED_IN_SALT='replace-me'
NONCE_SALT='replace-me'
