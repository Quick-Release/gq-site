{
  "name": "getquick/{{project}}-cms",
  "type": "project",
  "license": "MIT",
  "description": "{{Project}}'s Bedrock WordPress content API powered by WPGraphQL",
  "homepage": "https://roots.io/bedrock/",
  "authors": [
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "bedrock",
    "composer",
    "roots",
    "wordpress-composer",
    "wordpress",
    "wp-composer",
    "wp-config",
    "wp"
  ],
  "support": {
    "issues": "https://github.com/roots/bedrock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "repositories": [
    {
      "name": "getquick",
      "type": "composer",
      "url": "https://proxy.composer.getquick.io",
      "only": [
        "getquick/*"
      ]
    },
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "getquick/gq-config": "^0.4.0",
    "getquick/getquick-theme": "^0.5.1",
    "getquick/gq-design": "^0.3.1",
    "getquick/gq-support": "^0.1.3",
    "humanmade/s3-uploads": "^3.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.2",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "wp-plugin/cimo-image-optimizer": "^1.4",
    "wp-plugin/safe-svg": "^2.5",
    "wp-plugin/simple-history": "^5.34",
    "wp-plugin/wp-graphql": "^2.23",
    "wp-plugin/wpgraphql-blocks": "^2.2",
    "wp-theme/twentytwentyfive": "^1.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": [
      "pint --test config scripts tests web/app/mu-plugins/*.php web/index.php web/wp-config.php"
    ],
    "lint:fix": [
      "pint config scripts tests web/app/mu-plugins/*.php web/index.php web/wp-config.php"
    ],
    "test": "pest"
  }
}
