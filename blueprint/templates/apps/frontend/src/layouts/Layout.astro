---
import type { Alternate, DesignBlock, DesignTheme, SiteChrome, SiteLanguage } from "@getquick/content";
import { designThemeStyleSheet, presentationStyleSheet, resolveDesignTheme, videoHeroStyleSheet } from "@getquick/content";
import { consentPage } from "@getquick/content/consent/astro";
import { content } from "../lib/content";
import { copyFor } from "../lib/copy";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** The chrome the page was served with; left out, the layout looks it up. */
  chrome?: SiteChrome | null;
  /** The page's language; left out, the site's default language. */
  language?: SiteLanguage;
  /** Where its readers may switch language (a multilingual Site's pages only). */
  alternates?: Alternate[];
  /** The resolved theme delivered with the publication. */
  theme?: DesignTheme;
}

const runtime = content();
const {
  title = "{{Project}}",
  description = "",
  language = runtime.defaultLanguage,
  alternates = [],
} = Astro.props;
const chrome =
  Astro.props.chrome !== undefined
    ? Astro.props.chrome
    : await runtime.pageChrome(Astro.site?.origin);
const theme = resolveDesignTheme(Astro.props.theme ?? (await runtime.designPresets())?.theme);
// Chrome that can't be served leaves the menu, logo and icon out of this
// response only; it doesn't mean the site has none, so the page is still served.
const { menuItems, siteIcon, siteLogo } = chrome ?? {
  menuItems: [],
  siteIcon: null,
  siteLogo: null,
};
// The header and footer editors select in GQ Design's Header & Footer, as
// the chrome serves them; empty when it serves none (the region uses a
// template part, nothing published is selected, or the CMS's GQ Design is
// older than 0.4.1), and the layout keeps its own. Saved HTML renders as it
// was published; a block that needs code (a dynamic or Site block) needs a
// renderer in `blocks` (see @getquick/content's "Header and footer patterns").
const patternOptions = {
  siteOrigin: Astro.site?.origin,
  home: language.home,
  onUnrendered: (block: DesignBlock) => console.warn(`No renderer for ${block.name}`),
};
const headerPattern = runtime.renderDesignPattern(chrome?.header, patternOptions);
const footerPattern = runtime.renderDesignPattern(chrome?.footer, patternOptions);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
// The page and its published translations, in the site's language order,
// each under its language's tag, then the default language's as x-default.
const translations = alternates.filter((alternate) => alternate.translation);
const hreflang =
  translations.length === 0
    ? []
    : runtime.languages.flatMap((siteLanguage) => {
        if (siteLanguage.slug === language.slug) return [{ language: siteLanguage, href: canonical.href }];
        const translation = translations.find(
          (alternate) => alternate.language.slug === siteLanguage.slug,
        );
        return translation
          ? [{ language: siteLanguage, href: new URL(translation.route, Astro.site ?? Astro.url).href }]
          : [];
      });
const xDefault = hreflang.find((alternate) => alternate.language.isDefault);
// The consent Runtime's UI (CONSENT-1, LEGAL-1; docs/guides/consent.md), in
// the page's language: its configuration and styles in the head, the banner
// and preferences dialog first in the body, the legal links and the "Cookie
// settings" control in the footer. The banner is rendered open only without a
// decision in force. Restyle it through the --gq-consent-* custom properties.
const configuration = runtime.consentConfiguration(chrome);
const consent = configuration
  ? consentPage({
      configuration,
      language: language.lang,
      legal: chrome?.legal,
      cookie: Astro.request.headers.get("cookie"),
    })
  : null;
---

<!doctype html>
<html lang={language.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={siteIcon?.sourceUrl || "/favicon.svg"} />
    <link rel="canonical" href={canonical} />
    {hreflang.map((alternate) => <link rel="alternate" hreflang={alternate.language.lang} href={alternate.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}
    <title>{title === "{{Project}}" ? title : `${title} — {{Project}}`}</title>
    <style is:inline set:html={designThemeStyleSheet(theme)} />
    <style is:inline set:html={videoHeroStyleSheet()} />
    <style is:inline set:html={presentationStyleSheet(theme)} />
    {consent && <Fragment set:html={consent.head} />}
  </head>
  <body>
    {consent && <Fragment set:html={consent.body} />}
    <header class={headerPattern ? "gqd-content" : "site-header"}>
      {headerPattern ? (
        <Fragment set:html={headerPattern} />
      ) : (
        <>
          <a href={language.home} class="site-header__home">
            {siteLogo ? <img src={siteLogo.sourceUrl} alt={siteLogo.altText || "{{Project}}"} /> : "{{Project}}"}
          </a>
          {menuItems.length > 0 && (
            <nav aria-label="Primary">
              <ul>
                {menuItems.map((item) => (
                  <li>
                    <a href={item.href} target={item.target ?? undefined}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
        </>
      )}
      {alternates.length > 0 && (
        <nav class="language-switcher" aria-label={copyFor(language, runtime.multilingual).languages}>
          <ul>
            {alternates.map((alternate) => (
              <li>
                <a href={alternate.route} hreflang={alternate.language.lang} lang={alternate.language.lang}>
                  {alternate.language.slug.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>
    <slot />
    {(footerPattern || consent) && (
      <footer class="site-footer">
        {footerPattern && <div class="gqd-content"><Fragment set:html={footerPattern} /></div>}
        {consent && <Fragment set:html={consent.footer} />}
      </footer>
    )}
    <script>
      // Applies the visitor's decisions, loads each catalog service only after
      // its grant, and records decisions at /gq/consent.
      import { startConsent } from "@getquick/content/consent/client";
      import { mountVideoHero } from "@getquick/content/design/client";
      startConsent();
      let unmountHeroes = () => {};
      const mountHeroes = () => {
        unmountHeroes();
        const cleanups = [...document.querySelectorAll<HTMLElement>(".wp-block-getquick-design-video-hero")].map(mountVideoHero);
        unmountHeroes = () => cleanups.forEach((cleanup) => cleanup());
      };
      mountHeroes();
      window.addEventListener("pagehide", () => unmountHeroes());
      window.addEventListener("pageshow", mountHeroes);
    </script>
  </body>
</html>
