---
import { pageChrome } from "../lib/delivery";
import { siteLang } from "../lib/site-language";
import type { SiteChrome } from "../lib/wordpress";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** The chrome the page was served with; left out, the layout looks it up. */
  chrome?: SiteChrome | null;
}

const { title = "{{Project}}", description = "" } = Astro.props;
const chrome =
  Astro.props.chrome !== undefined ? Astro.props.chrome : await pageChrome(Astro.site?.origin);
// Chrome that can't be served leaves the menu, logo and icon out of this
// response only; it doesn't mean the site has none, so the page is still served.
const { menuItems, siteIcon, siteLogo } = chrome ?? {
  menuItems: [],
  siteIcon: null,
  siteLogo: null,
};
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang={siteLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={siteIcon?.sourceUrl || "/favicon.svg"} />
    <link rel="canonical" href={canonical} />
    <title>{title === "{{Project}}" ? title : `${title} — {{Project}}`}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-header__home">
        {siteLogo ? <img src={siteLogo.sourceUrl} alt={siteLogo.altText || "{{Project}}"} /> : "{{Project}}"}
      </a>
      {menuItems.length > 0 && (
        <nav aria-label="Primary">
          <ul>
            {menuItems.map((item) => (
              <li>
                <a href={item.href} target={item.target ?? undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>
    <slot />
  </body>
</html>
