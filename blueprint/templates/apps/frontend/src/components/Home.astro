---
import Layout from "../layouts/Layout.astro";
import { copyFor } from "../lib/copy";
import type { HomeDelivery } from "../lib/delivery";
import type { SiteLanguage } from "../lib/site-language";
import { blockPresetStyles } from "../lib/wp-block-styles";

// A language's home (/, /en/), as its page served it: the page sets the
// response's status and headers, this renders what it was served.
interface Props {
  home: HomeDelivery;
  language: SiteLanguage;
  /** Local development without a CMS: a friendly placeholder instead of the 503. */
  placeholder: boolean;
}

const { home, language, placeholder } = Astro.props;
const copy = copyFor(language);
const content = home.kind === "found" ? home.content.home : null;
const chrome = home.kind === "found" ? home.content.chrome : home.kind === "missing" ? home.chrome : null;
const alternates = home.kind === "found" ? home.content.alternates : [];
const { vars, colorRules } = blockPresetStyles(content?.spacingSizes ?? [], content?.colors ?? []);
const siteTitle = content?.page.title || content?.settings.title || "{{Project}}";
const isVideoHeroPage = content?.page.hasVideoHero ?? false;
---

<Layout title={siteTitle} description={content?.settings.description} chrome={chrome} language={language} alternates={alternates}>
  {content?.page.content ? (
    <>
      <style is:global set:html={colorRules} />
      <main class={isVideoHeroPage ? "prose-wp prose-wp--video-hero" : "prose-wp"} style={vars} set:html={content.page.content}></main>
    </>
  ) : home.kind !== "unavailable" ? (
    <main class="empty-state">
      <h1>{copy.frontPageMissing.heading}</h1>
      <p>{copy.frontPageMissing.text}</p>
    </main>
  ) : placeholder ? (
    <main class="empty-state">
      <h1>{copy.frontPagePlaceholder.heading}</h1>
      <p>{copy.frontPagePlaceholder.text}</p>
    </main>
  ) : (
    <main class="empty-state">
      <h1>{copy.frontPageUnavailable.heading}</h1>
      <p>{copy.frontPageUnavailable.text}</p>
    </main>
  )}
</Layout>
