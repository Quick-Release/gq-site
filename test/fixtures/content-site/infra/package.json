{
  "name": "@larkspur/infrastructure",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:frontend": "node scripts/deploy-frontend.mjs",
    "deploy:frontend:adopt": "node scripts/deploy-frontend.mjs --adopt",
