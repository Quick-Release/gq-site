    "alchemy": "catalog:",
    "effect": "catalog:",
    "hono": "4.12.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
