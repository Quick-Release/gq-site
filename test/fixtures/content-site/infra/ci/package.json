    "@cloudflare/sandbox": "0.12.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
