{
  "name": "@larkspur/ci",
  "private": true,
  "description": "Cloudflare CI (Artifacts + CI Workflows) for the Larkspur monorepo.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --containers-rollout=none --outdir .wrangler/dry-run"
  },
  "dependencies": {
