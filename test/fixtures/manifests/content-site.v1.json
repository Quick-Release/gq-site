{
  "$schema": "./node_modules/@getquick/site/schema/gq.ops.schema.json",
  "schemaVersion": 1,
  "project": "larkspur",
  "variant": "content",
  "sigillo": {
    "apiUrl": "https://secrets.getquick.io",
    "projectId": "01M32W12VJR8EDZKGZ4DJP5GK5",
    "environments": {
      "local": "dev",
      "operations": "ops",
      "staging": "staging"
    }
  },
  "domains": {
    "admin": "larkspur-admin.bnq.pt",
    "frontend": "larkspur-fe.bnq.pt"
  },
  "ploi": {
    "serverId": "102329",
    "siteId": "410834",
    "systemUser": "larkspur",
    "projectRoot": "/",
    "webDirectory": "/apps/cms/web",
    "database": "larkspur_staging",
    "envTemplate": "apps/cms/.env.production.example",
    "deployScript": "deploy/ploi/admin.sh"
  },
  "wordpress": {
    "plugins": [
      "getquick-design",
      "larkspur-post-types",
      "larkspur-blocks",
      "gq-support",
      "wp-graphql",
      "wpgraphql-blocks",
      "s3-uploads",
      "simple-history",
      "cimo-image-optimizer",
      "safe-svg"
    ]
  },
  "releases": {
    "bucket": "larkspur-releases",
    "prefix": "admin/"
  },
  "media": {
    "bucket": "larkspur-media",
    "domain": "larkspur-media.bnq.pt"
  },
  "backups": {
    "bucket": "larkspur-releases",
    "prefix": "db/"
  },
  "local": {
    "adminEmail": "dev@tipme.to"
  },
  "artifacts": {
    "namespace": "larkspur",
    "repo": "larkspur"
  },
  "ci": {
    "worker": "larkspur-ci",
    "backupBucket": "larkspur-ci-backups"
  },
  "cloudflare": {
    "accountId": "8f38791a8c37b182239af2a385ab3c31",
    "zoneId": "60c031fb6f81fae300c625224c39c758",
    "zoneName": "bnq.pt"
  },
  "github": {
    "repository": "Quick-Release/larkspur"
  },
  "release": {
    "textFiles": [
      {
        "path": "apps/cms/web/app/themes/larkspur-theme/style.css",
        "patterns": [
          {
            "regexp": "^Version: .+$",
            "flags": "m",
            "replacement": "Version: {version}"
          }
        ]
      },
      {
        "path": "apps/cms/web/app/themes/larkspur-theme/functions.php",
        "patterns": [
          {
            "regexp": "define\\( 'LARKSPUR_THEME_VERSION', '[^']+' \\);",
            "replacement": "define( 'LARKSPUR_THEME_VERSION', '{version}' );"
          }
        ]
      }
    ],
    "paths": [
      "apps/cms/web/app/themes/larkspur-theme/style.css",
      "apps/cms/web/app/themes/larkspur-theme/functions.php"
    ]
  }
}
