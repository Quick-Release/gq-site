{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "enum": [
        "content",
        "commerce"
      ]
    },
    "domains": {
      "type": "object",
      "properties": {
        "admin": {
          "type": "string",
          "minLength": 1
        },
        "frontend": {
          "type": "string",
          "minLength": 1
        },
        "docs": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "admin",
        "frontend"
      ],
      "additionalProperties": false
    },
    "sigillo": {
      "type": "object",
      "properties": {
        "apiUrl": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "environments": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ploi": {
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string"
        },
        "siteId": {
          "type": "string"
        },
        "systemUser": {
          "type": "string"
        },
        "projectRoot": {
          "type": "string"
        },
        "webDirectory": {
          "type": "string"
        },
        "database": {
          "type": "string"
        },
        "envTemplate": {
          "type": "string"
        },
        "deployScript": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "wordpress": {
      "type": "object",
      "properties": {
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][\\w.-]*$"
          },
          "description": "The plugins the CMS deploy script activates, in order."
        },
        "locale": {
          "description": "The site's main language, as a WordPress locale (pt_PT_ao90): the CMS deploy script installs and activates it, and the Frontend's <html lang> follows it. Left out, the deploy leaves the CMS's language as it is.",
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:_[A-Z]{2})?(?:_[a-z0-9]+)?$"
        },
        "languages": {
          "description": "The languages beside the default (locale), each under its URL directory (slug): the CMS deploy script installs them and makes Polylang's languages match. Needs locale, Polylang and gq-polylang-graphql. Left out, the Site is monolingual.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(?:_[A-Z]{2})?(?:_[a-z0-9]+)?$"
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "locale",
              "slug"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "plugins"
      ],
      "additionalProperties": false
    },
    "releases": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "bucket"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bucket",
        "domain"
      ],
      "additionalProperties": false
    },
    "backups": {
      "type": "object",
      "properties": {
        "bucket": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "bucket"
      ],
      "additionalProperties": false
    },
    "local": {
      "type": "object",
      "properties": {
        "adminEmail": {
          "type": "string"
        },
        "frontendUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "jurisdiction": {
          "description": "Where the Artifacts namespace keeps the Site's code: gq cloudflare ci creates it there, and stops at an existing one elsewhere. Left out, \"eu\"; \"unrestricted\" opts out. Cloudflare can't change it after the namespace is created.",
          "type": "string",
          "enum": [
            "eu",
            "us",
            "unrestricted"
          ]
        }
      },
      "required": [
        "namespace",
        "repo"
      ],
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "worker": {
          "type": "string"
        },
        "backupBucket": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cloudflare": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string"
        },
        "zoneId": {
          "type": "string"
        },
        "zoneName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "description": "Added to the variant's version files, text patterns and release paths.",
      "type": "object",
      "properties": {
        "jsonFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "textFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "patterns": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "regexp": {
                      "type": "string"
                    },
                    "flags": {
                      "type": "string"
                    },
                    "replacement": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "regexp",
                    "replacement"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "patterns"
            ],
            "additionalProperties": false
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "verify": {
      "description": "Added to the variant's checks, which run after them.",
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "php",
                    "ddev"
                  ]
                }
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "doctor": {
      "description": "Added to the files the variant requires in each app.",
      "type": "object",
      "properties": {
        "requiredFiles": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "offboarded": {
      "description": "Written by gq offboard: the Site is offboarded, and gq refuses whatever would expose it again.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "cut",
            "archived"
          ]
        },
        "cut": {
          "description": "Written by gq offboard as it cuts: what it changed (the final backup, the retry crontab, the suspension, detached Worker domains, each Worker's workers.dev setting before, the media domain, the webhook id and the token ids it disabled); gq offboard --restore brings back only these.",
          "type": "object",
          "properties": {
            "backup": {
              "type": "boolean",
              "const": true
            },
            "crontab": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string",
                  "minLength": 1
                },
                "frequency": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "user",
                "frequency",
                "command"
              ],
              "additionalProperties": false
            },
            "suspended": {
              "type": "boolean",
              "const": true
            },
            "workerDomains": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "hostname": {
                    "type": "string",
                    "minLength": 1
                  },
                  "service": {
                    "type": "string",
                    "minLength": 1
                  },
                  "zoneId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hostname",
                  "service",
                  "zoneId"
                ],
                "additionalProperties": false
              }
            },
            "workersDev": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "previewsEnabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled",
                  "previewsEnabled"
                ],
                "additionalProperties": false
              }
            },
            "mediaDomain": {
              "type": "string",
              "minLength": 1
            },
            "webhook": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "tokens": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "archive": {
          "description": "Written by gq offboard --archive once the archive is verified: where it is, and its manifest.json's sha256.",
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "prefix": {
              "type": "string",
              "minLength": 1
            },
            "manifestSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "bucket",
            "prefix",
            "manifestSha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "at",
        "phase"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "variant"
  ],
  "additionalProperties": false,
  "title": "gq.ops.json",
  "description": "A GETQUICK site's manifest (schema v1)."
}
