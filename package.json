{
  "name": "@getquick/site",
  "version": "0.17.5",
  "description": "Shared tooling for GETQUICK sites: the gq CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gq": "bin/gq.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "blueprint",
    "src",
    "schema",
    "docs/README.md",
    "docs/guides",
    "docs/reference",
    "docs/development.md",
    "docs/research/ploi-api.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "vp check && vp run test",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "test": "node --test \"test/*.test.mjs\" \"test/{ci,cli,cloudflare,cms,db,frontend,manifest,media,offboard,ops,ploi,release,scope,sigillo,site,skills,sync,workspace}/*.test.mjs\"",
    "schema": "node scripts/generate-schema.mjs",
    "release:publish": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "aws4fetch": "1.0.20",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "sigillo": "0.13.0",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quick-Release/gq-site.git"
  },
  "keywords": [
    "getquick",
    "cloudflare",
    "ploi",
    "cli",
    "operations"
  ]
}
