{
  "permissions": {
    "allow": [
      "Bash(git push origin main:*)",
      "Bash(git push origin v:*)",
      "Bash(git tag v:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push:*)",
      "Bash(pnpm release:publish)",
      "Bash(herdr pane close:*)",
      "Bash(herdr agent start:*)",
      "Bash(herdr agent prompt:*)",
      "Bash(herdr agent send-keys:*)",
      "Bash(herdr pane split:*)",
      "Bash(herdr pane rename:*)",
      "Bash(herdr pane list:*)",
      "Bash(herdr pane read:*)",
      "Bash(herdr agent list:*)",
      "Bash(herdr agent get:*)",
      "Bash(herdr agent read:*)",
      "Bash(herdr agent wait:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git merge:*)",
      "Bash(pnpm install:*)",
      "Bash(git push origin main)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/gq.mjs\" scope route --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/gq.mjs\" scope fence --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
